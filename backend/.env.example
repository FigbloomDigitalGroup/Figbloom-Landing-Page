# Local development. Copy to backend/.env — it is gitignored and never deployed.
# Production values live in the Render dashboard (see render.yaml).

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=any-random-string-for-local-use

# Leave DATABASE_URL unset to keep using backend/db.sqlite3 locally.
# DATABASE_URL=postgres://user:password@localhost:5432/figbloom

# Leave the AWS_* vars unset to keep CV uploads in backend/media/ locally.
# AWS_STORAGE_BUCKET_NAME=figbloom-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Truehost mailbox — same credentials as Render's EMAIL_HOST_USER/PASSWORD.
# EMAIL_HOST/PORT/USE_SSL default correctly in settings.py, so only the
# account itself needs to be set here.
EMAIL_HOST_USER=sales@figbloom.org
EMAIL_HOST_PASSWORD= #your password here
DEFAULT_FROM_EMAIL=Figbloom Digital Group <sales@figbloom.org>
    